# Copy to .env and fill in any optional keys, then `docker compose up --build`.

# WebMCP origin-trial token (optional; otherwise launch Chrome with --enable-features=WebMCP)
ORIGIN_TRIAL_TOKEN=

# FlyNow — Duffel live flight offers (test mode)
DUFFEL_API_KEY=

# Stayly — Hotelbeds APItude live hotel offers (test sandbox)
HOTELBEDS_API_KEY=
HOTELBEDS_SECRET=

# Concierge — LLM mode (optional; without it the deterministic planner runs)
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
# Force the planner: "deterministic" | "llm" | unset (auto = llm when key present)
PLANNER=
